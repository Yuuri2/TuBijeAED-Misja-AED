<?xml version='1.0' encoding='UTF-8'?>
<!-- Przykładowy plik harvestera XML 1.14 (prototyp #TuBijeAED).
     Nowość względem 1.13: element <aggregatedListType>AED</aggregatedListType> w <resource>
     (zastępuje containsProtectedData – oznacza zasób wchodzący do wykazu zbiorczego AED).
     Dane są przykładowe. Adres demo.tubijeaed.example działa tylko w prototypie (offline, plik wbudowany w serwer); w prawdziwym pliku wpisz adres własnego CSV/XLSX. -->
<ns2:datasets xmlns:ns2="urn:otwarte-dane:harvester:1.14" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataset status="published">
		<extIdent>aed-przyklad-zbior-1</extIdent>
		<title>
			<polish>Defibrylatory AED – przykładowy zbiór dostawcy</polish>
			<english>AED defibrillators – example provider dataset</english>
		</title>
		<description>
			<polish>Lokalizacje defibrylatorów AED udostępnione przez dostawcę zgodnie ze wzorcem danych #TuBijeAED.</polish>
			<english>Locations of AED defibrillators published according to the #TuBijeAED data template.</english>
		</description>
		<url>https://example.org/aed</url>
		<updateFrequency>irregular</updateFrequency>
		<hasDynamicData>false</hasDynamicData>
		<hasHighValueData>false</hasHighValueData>
		<hasHighValueDataFromEuropeanCommissionList>false</hasHighValueDataFromEuropeanCommissionList>
		<hasResearchData>false</hasResearchData>
		<categories>
			<category>HEAL</category>
		</categories>
		<conditions>
			<source></source>
			<modification></modification>
			<responsibilities></responsibilities>
			<dbOrCopyrighted>Warunek wymagany</dbOrCopyrighted>
			<dbOrCopyrightedLicenseChosen>CC BY 4.0</dbOrCopyrightedLicenseChosen>
		</conditions>
		<resources>
			<resource status="published">
				<extIdent>aed-przyklad-zasob-1</extIdent>
				<url>https://demo.tubijeaed.example/warszawa_aed_demo.csv</url>
				<title>
					<polish>Wykaz defibrylatorów AED (CSV)</polish>
					<english>AED defibrillators list (CSV)</english>
				</title>
				<description>
					<polish>Plik CSV zgodny ze wzorcem danych AED; wchodzi do Wykazu zbiorczego AED.</polish>
					<english>CSV file compliant with the AED data template; included in the aggregated AED list.</english>
				</description>
				<availability>remote</availability>
				<dataDate>2026-11-21</dataDate>
				<lastUpdateDate>2026-11-21T12:00:00.000Z</lastUpdateDate>
				<hasDynamicData>false</hasDynamicData>
				<hasHighValueData>false</hasHighValueData>
				<hasHighValueDataFromEuropeanCommissionList>false</hasHighValueDataFromEuropeanCommissionList>
				<hasResearchData>false</hasResearchData>
				<aggregatedListType>AED</aggregatedListType>
			</resource>
		</resources>
		<tags>
			<tag lang="pl">AED</tag>
			<tag lang="pl">defibrylator</tag>
		</tags>
		<lastUpdateDate>2026-11-21T12:00:00.000Z</lastUpdateDate>
	</dataset>
</ns2:datasets>
