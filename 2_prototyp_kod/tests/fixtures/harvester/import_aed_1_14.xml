<?xml version="1.0" encoding="UTF-8"?>
<!-- Przykład importu harvestera XML 1.14 (#TuBijeAED, prototyp HackNation 2026).
     Zbiór gminy (Urząd m.st. Warszawy) z jednym zasobem oznaczonym jako element Wykazu zbiorczego AED
     (aggregatedListType = AED) i jednym zwykłym zasobem. Dane w warszawa_aed_demo.csv są FIKCYJNE (demo).
     Adres https://demo.tubijeaed.example/... (domena zastrzeżona RFC 2606) harvester prototypu czyta offline
     z app/harvester/demo_pliki/. -->
<ns2:datasets xmlns:ns2="urn:otwarte-dane:harvester:1.14">
  <dataset status="published">
    <extIdent>waw-defibrylatory-aed</extIdent>
    <title>
      <polish>Defibrylatory AED – Urząd m.st. Warszawy</polish>
      <english>AED defibrillators – City of Warsaw</english>
    </title>
    <description>
      <polish>Lokalizacje automatycznych defibrylatorów zewnętrznych (AED) w budynkach urzędu, według wzorcowego zakresu danych AED. Za dane odpowiada Urząd m.st. Warszawy.</polish>
    </description>
    <updateFrequency>monthly</updateFrequency>
    <categories>
      <category>HEAL</category>
    </categories>
    <conditions>
      <source>true</source>
      <modification>true</modification>
      <dbOrCopyrightedLicenseChosen>CC BY 4.0</dbOrCopyrightedLicenseChosen>
    </conditions>
    <resources>
      <resource status="published">
        <extIdent>waw-aed-csv</extIdent>
        <url>https://demo.tubijeaed.example/warszawa_aed_demo.csv</url>
        <title>
          <polish>Defibrylatory AED – Urząd m.st. Warszawy (CSV, wzorzec AED)</polish>
        </title>
        <description>
          <polish>Plik CSV UTF-8 zgodny ze wzorcowym zakresem danych AED.</polish>
        </description>
        <availability>local</availability>
        <dataDate>2026-11-20</dataDate>
        <lastUpdateDate>2026-11-20T10:00:00Z</lastUpdateDate>
        <hasDynamicData>false</hasDynamicData>
        <hasHighValueData>false</hasHighValueData>
        <hasResearchData>false</hasResearchData>
        <containsProtectedData>false</containsProtectedData>
        <aggregatedListType>AED</aggregatedListType>
        <regions>
          <terytIdent>1465011</terytIdent>
        </regions>
      </resource>
      <resource status="published">
        <extIdent>waw-aed-zasady</extIdent>
        <url>https://demo.tubijeaed.example/zasady_aed.txt</url>
        <title>
          <polish>Zasady rozmieszczania AED w budynkach urzędu</polish>
        </title>
        <description>
          <polish>Dokument opisowy – nie wchodzi do wykazu zbiorczego.</polish>
        </description>
        <availability>remote</availability>
      </resource>
    </resources>
    <tags>
      <tag lang="pl">AED</tag>
      <tag lang="pl">defibrylator</tag>
      <tag lang="pl">#TuBijeAED</tag>
    </tags>
  </dataset>
</ns2:datasets>
